        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      },
      "url": "",
      "headers": {},
      "enabled": true,
      "fromGalleryId": "modelcontextprotocol.servers_github"
    }
  ]
}
