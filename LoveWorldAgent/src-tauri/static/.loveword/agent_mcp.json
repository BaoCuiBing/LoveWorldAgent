{
  "servers": [
    {
      "name": "Chrome DevTools MCP",
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {},
      "url": "",
      "headers": {},
      "enabled": true,
      "fromGalleryId": "byted-mcp.chrome-devtools-mcp"
    },
    {
      "name": "GitHub",
      "type": "stdio",
